#include<stdio.h>
#include<conio.h>
#define N 10
int stack[N];
int top=-1;
void push(){
    int x;
    printf("enter data :");
    scanf("%d",&x);
    if(top==N-1){
        printf("stack overflow");
    }
    else{
        top++;
        stack[top]=x;
    }
}
void pop(){
    int y;
    if(top==-1){
        printf("stack overflow");
    }
    else{
        y=stack[top];
        top--;
        printf("intem deleted =%d",&y);
    }
}
void peek(){
    int item;
    if(top==-1){
        printf("stack overflow");
    }
    else{
        item=stack[top];
        printf("item at top pf stack = %d",&item);
    }
}
void display(){
    if(top ==-1){
        printf("stack is empty");
    }
    else{
        for(int i=top-1;i>=0;i--){
            printf(stack[i]);
        }
    }
}
void main(){
    int x;
    while (1){
        printf("\n1 for push\n2 for pop\n3 for peek\n4 for display\n5 for exit\n enter your choice:");
        scanf("%d",&x);
        switch(x){
            case 1: push();
            break;
            case 2: pop();
            break;
            case 3: peek();
            break;
            case 4: display();
            break;
            case 5:
            exit(0);
            default:
            printf("Invalid input");
            break;
            
        }
    }
}

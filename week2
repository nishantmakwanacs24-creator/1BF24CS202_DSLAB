#include <stdio.h>
#include <ctype.h>
#include <string.h>

#define MAX 100

char stack[MAX];
int top = -1;

void push(char c) {
    if (top == MAX - 1) {
        printf("stack overflow\n");
        return;
    }
    stack[++top] = c;
}

char peek() {
    if (top == -1) {
        return -1;
    }
    return stack[top];
}

char pop() {
    if (top == -1) {
        printf("stack underflow \n");
        return -1;
    }
    return stack[top--];
}

int precedence(char x) {
    switch (x) {
        case '+': return 1;
        case '-': return 1;
        case '/': return 2;
        case '*': return 2;
        case '^': return 3;
        case '(': return 0;
    }
    return -1;
}

int associativity(char x) {
    if (x == '^') {
        return 1;  
    }
    return 0; 
}

void I_to_P(char infix[], char postfix[]) {
    int i, k = 0;
    char c;
    for (i = 0; infix[i] != '\0'; i++) {
        c = infix[i];

        if (isalnum(c)) {
            postfix[k++] = c;
        }
        else if (c == '(') {
            push(c);
        }
        else if (c == ')') {
            while (peek() != '(' && top != -1) {
                postfix[k++] = pop();
            }
            pop(); 
        }
        else {
            while (top != -1 && 
                  ((precedence(peek()) > precedence(c)) || 
                   (precedence(peek()) == precedence(c) && associativity(c) == 0))) {
                postfix[k++] = pop();
            }
            push(c);
        }
    }
    while (top != -1) {
        postfix[k++] = pop();
    }
    postfix[k] = '\0';
}

int main() {
    char infix[MAX], postfix[MAX];
    printf("Enter an expression: ");
    scanf("%s", infix);
    I_to_P(infix, postfix);
    printf("Postfix expression: %s\n", postfix);
    return 0;
}
